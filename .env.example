# ─── Resend Email Delivery ────────────────────────────────────────────────────
# Get your API key from https://resend.com/api-keys
RESEND_API_KEY=RESEND_API_KEY

# The inbox where contact form messages will be delivered
CONTACT_EMAIL=youremailid

# Sender address shown in the From: field.
# Free Resend accounts must use: onboarding@resend.dev
# Or use a custom domain you've verified at https://resend.com/domains
FROM_EMAIL=onboarding@resend.dev
FROM_NAME=Vijay Portfolio Contact Form

# ─── Server (standalone Express only) ────────────────────────────────────────
PORT=5000
